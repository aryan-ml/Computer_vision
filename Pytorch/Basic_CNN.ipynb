  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "## Implementation of a simple CNN on MNIST dataset\n",
        "- input_channels = 1 `black and white`\n",
        "- Flow = `conv-relu-pool-conv2-relu-pool-maxpool-fc`\n" 
        "- `Here fc needs a flatten input so we take care of that`"
      ],
      "metadata": {
        "id": "l2yN72pWnbag"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader\n",
        "import torchvision.datasets as data\n",
        "import torchvision.transforms as transforms\n"
      ],
      "metadata": {
        "id": "u90pKUWyW7jo"
      },
      "execution_count": 59,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')"
      ],
      "metadata": {
        "id": "zDmMqBkxftF_"
      },
      "execution_count": 60,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Hyperparameters"
      ],
      "metadata": {
        "id": "vRM5zgcXoJtO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "in_channels=1\n",
        "classes = 10\n",
        "learning_rate = 0.001\n",
        "epochs = 5\n",
        "batch_size=64"
      ],
      "metadata": {
        "id": "xHGGcwLNZPkp"
      },
      "execution_count": 89,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Defining CNN Model"
      ],
      "metadata": {
        "id": "q2LI7FEkoM0d"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class CNN(nn.Module):\n",
        "  def __init__(self, in_channel , classes):\n",
        "    super(CNN, self).__init__()\n",
        "    self.conv1 = nn.Conv2d(in_channels=in_channel, out_channels=8, kernel_size=(3,3), padding=1, stride=1)     ## Keeps the output dimenstions same\n",
        "    self.pool = nn.MaxPool2d(kernel_size=(2,2), stride=2)       ## Will reduce the size of the image by half due to the kernel size and stride\n",
        "    self.conv2 = nn.Conv2d(in_channels=8, out_channels=16, kernel_size=(3,3), padding=1, stride=1)\n",
        "    self.fc = nn.Linear(16*7*7,  classes)       ## we will apply the maxpool layer 2 times resulting in 28 --> 14 --> 7\n",
        "\n",
        "\n",
        "  def forward(self, x):\n",
        "    x = F.relu(self.conv1(x))\n",
        "    x = self.pool(x)\n",
        "    x = F.relu(self.conv2(x))\n",
        "    x = self.pool(x)\n",
        "    x = x.flatten(1)\n",
        "    x = self.fc(x)\n",
        "\n",
        "    return x"
      ],
      "metadata": {
        "id": "ZsKx2Cr0XbpJ"
      },
      "execution_count": 90,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Rest remains the same as the normal NN\n",
        "> I have removed the parts where we had the flattern the input we dont have to do that anymore as we are already taking care of that in the model section itself"
      ],
      "metadata": {
        "id": "8joETOc2oYLf"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "train_data = data.MNIST(root='./data', train=True, download=True, transform=transforms.ToTensor())\n",
        "train_loader = DataLoader(dataset=train_data, shuffle=True, batch_size=batch_size)\n",
        "\n",
        "test_data = data.MNIST(root='./data', train=False, download=True, transform=transforms.ToTensor())\n",
        "test_loader = DataLoader(dataset=test_data, shuffle=False, batch_size=batch_size)"
      ],
      "metadata": {
        "id": "OezlXhnVaJSg"
      },
      "execution_count": 91,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "model = CNN(in_channels, classes).to(device)\n",
        "\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "optimizer = optim.Adam(model.parameters(), lr=learning_rate)"
      ],
      "metadata": {
        "id": "7eywY9z7cDAp"
      },
      "execution_count": 92,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "for i in range(epochs):\n",
        "  for batch_idx, (inputs, targets) in enumerate(train_loader):\n",
        "    inputs = inputs.to(device)\n",
        "    targets = targets.to(device)\n",
        "\n",
        "    scores = model(inputs)\n",
        "    current_loss = criterion(scores, targets)\n",
        "\n",
        "    optimizer.zero_grad()\n",
        "    current_loss.backward()\n",
        "    optimizer.step()"
      ],
      "metadata": {
        "id": "EZRbFhh7gYC_"
      },
      "execution_count": 93,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def  acc(loader, model):\n",
        "  correct = 0\n",
        "  sample = 0\n",
        "  model.eval()\n",
        "\n",
        "  with torch.no_grad():\n",
        "    for x, y in loader:\n",
        "      x = x.to(device)\n",
        "      y = y.to(device)\n",
        "\n",
        "      scores = model(x)\n",
        "      _, pred = scores.max(1)\n",
        "      correct += (pred == y).sum()\n",
        "      sample += pred.size(0)\n",
        "\n",
        "  model.train()\n",
        "\n",
        "  return correct, sample\n",
        "\n",
        "train_correct, train_samples = acc(train_loader, model)\n",
        "print(f\"Accuracy on training set: {train_correct.item() / train_samples * 100:.2f}%\")\n",
        "\n",
        "test_correct, test_samples = acc(test_loader, model)\n",
        "print(f\"Accuracy on test set: {test_correct.item() / test_samples * 100:.2f}%\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "PKvvrT8LhiNG",
        "outputId": "f3e0859b-0a68-4826-a295-470bf2ea6bf9"
      },
      "execution_count": 94,
